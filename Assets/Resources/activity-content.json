  "relicDefinitions": [
    {
      "id": "gungnir",
      "name": "궁니르",
      "location": 3,
      "description": "북유럽 신화에서 오딘을 상징하는 창. 이 성유물의 힘은 사용자의 전승 업적으로만 성장한다."
    },
    {
      "id": "grail",
      "name": "성배",
      "location": 3,
      "description": "아서왕 전승의 성배에서 모티프를 얻은 유물. 최초 능력치는 0이며 역대 사용자의 업적을 기록한다."
    },
    {
      "id": "solomon",
      "name": "솔로몬의 반지",
      "location": 3,
      "description": "솔로몬의 인장에 관한 후대 전승에서 모티프를 얻은 반지. 별도 전투 특수능력은 없다."
    },
    {
      "id": "necronomicon",
      "name": "네크로노미콘",
      "location": 3,
      "description": "러브크래프트 문학의 가공 서적에서 가져온 성유물. 외신 등급이나 고유 능력 없이 동일한 전승 공식을 적용한다."
    },
    {
      "id": "antikythera",
      "name": "안티키테라 기계",
      "location": 0,
      "description": "고대 그리스의 천문 계산 장치에서 모티프를 얻은 유물. 정교한 기어와 사용자의 역사가 남아 있다."
    },
    {
      "id": "nebra",
      "name": "네브라 하늘 원반",
      "location": 0,
      "description": "청동 원반 위의 금빛 천체 표현을 모티프로 삼았다. 성유물 능력은 전승 기록으로만 성장한다."
    },
    {
      "id": "dagger",
      "name": "투탕카멘의 운석 단검",
      "location": 0,
      "description": "투탕카멘 무덤의 운석 철제 단검에서 모티프를 얻었다. 최초의 체력·공격 보너스는 0이다."
    },
    {
      "id": "bicorne",
      "name": "나폴레옹의 이각모",
      "location": 0,
      "description": "나폴레옹을 상징하는 검은 이각모. 장비 등급 대신 역대 화신체의 기록이 가치를 만든다."
    }
  ],
